[Unit]
Description=MrVaga demo
After=network.target

[Service]
Type=simple
User=opc
Group=opc
WorkingDirectory=/srv/mrvaga
Environment=MRVAGA_BASE=/mrvaga/
ExecStart=/usr/bin/php -S 127.0.0.1:8113 -t showroom showroom/index.php
Restart=on-failure
RestartSec=2

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/mrvaga
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
